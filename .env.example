# Copy to .env and fill in real values as needed. Never commit a real .env file.

# "mock" (default) uses the deterministic offline provider; no API key required,
# and the full demo (tests, server, endpoints) works with this and no internet access.
# "anthropic" uses the real structured-output provider and requires ANTHROPIC_API_KEY.
LLM_PROVIDER=mock

# Only required when LLM_PROVIDER=anthropic. Never log this value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Rubric/version tag surfaced in health check and gap-stats responses.
RUBRIC_VERSION=v1

# Optional overrides. Leave unset to use the backend's own bundled fixture
# dataset and built-in rule config.
# JEONBUK_DATASET_PATH=data/curated/jeonbuk_postings.jsonl
# FIELD_RULES_PATH=backend/app/rules/field_rules.yaml
# GOLD_LABELS_PATH=data/gold/adjudicated_labels.json
