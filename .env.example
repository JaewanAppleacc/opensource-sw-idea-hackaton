# Copy to .env and fill in real values as needed. Never commit a real .env file.

# "mock" (default) uses the deterministic offline provider; no API key required,
# and the full demo (tests, server, endpoints) works with this and no internet access.
# "anthropic" uses the real structured-output provider and requires ANTHROPIC_API_KEY.
# "nvidia" is an alternate real-LLM provider (NVIDIA NIM, OpenAI-compatible tool
# calling) added only as a stand-in when the Anthropic account has no credit --
# not part of the core architecture; prefer "anthropic" when available.
LLM_PROVIDER=mock

# Only required when LLM_PROVIDER=anthropic. Never log this value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Only required when LLM_PROVIDER=nvidia. Never log this value. NVIDIA_API is
# accepted as a fallback name for the same key.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Comma-separated frontend origins allowed to call the local API in a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional overrides. With the merged repository, defaults resolve from the
# repository root regardless of which directory starts uvicorn:
# - matches: data/postings/postings.jsonl (clearly marked synthetic demo data)
# - rules: data/rubric/runtime_rules.yaml (version-aligned to rubric.yaml)
# - stats: data/gold/adjudicated_labels.jsonl (not ready until real human gold exists)
# JEONBUK_DATASET_PATH=/absolute/path/to/postings.jsonl
# FIELD_RULES_PATH=/absolute/path/to/runtime_rules.yaml
# GOLD_LABELS_PATH=/absolute/path/to/adjudicated_labels.jsonl
# POSTINGS_DATASET_PATH=/absolute/path/to/postings.jsonl

# --- Frontend (Vite reads any VITE_-prefixed var from this same .env file) ---
# Backend base URL the frontend calls. No API key belongs here -- the
# frontend never calls Anthropic/NVIDIA directly and never reads their keys.
VITE_API_BASE_URL=http://localhost:8000
